# 📁 Create project root
mkdir -p ~/aimetaverse-demo/{css,js,assets}
cd ~/aimetaverse-demo

# 📄 index.html - Investor Demo Landing Page
cat > index.html << 'EOF'
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
